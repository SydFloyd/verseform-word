{
  "name": "verseform-word",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "desktop:start": "npx --yes office-addin-debugging@6.1.2 start manifest.xml desktop --app Word --dev-server \"npm run dev\" --dev-server-port 3000 --no-debug",
    "desktop:stop": "npx --yes office-addin-debugging@6.1.2 stop manifest.xml",
    "build": "tsc -b && vite build",
    "manifest:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-production-manifest.ps1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "validate:manifest": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validate-manifest.ps1",
    "validate:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validate-release.ps1",
    "check": "npm run typecheck && npm run test && npm run build && npm run validate:manifest && npm run validate:release"
  },
  "dependencies": {
    "bible-tools": "0.2.4"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/office-js": "1.0.607",
    "office-addin-dev-certs": "2.0.10",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
